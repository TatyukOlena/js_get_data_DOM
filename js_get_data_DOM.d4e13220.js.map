var population = document.getElementsByClassName('population');
var numbers = Array.from(population).map(function(element) {
    var elem = element.textContent;
    var repl = elem.replaceAll(/[, ]/g, '');
    return Number(repl);
});
var total = numbers.reduce(function(sum, number) {
    return sum + number;
}, 0);
var average = Math.round(total / population.length);
